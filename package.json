{
  "name": "coee",
  "displayName": "coee",
  "description": "Understand any codebase in VS Code: an architecture overview as the hub, step-by-step walkthroughs beside the code, a live review of your git changes, a security scan, and change planning with code and tests. Edits your files only when you click Add and confirm.",
  "version": "1.0.0",
  "publisher": "coee",
  "license": "MIT",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#FFFFFF",
    "theme": "light"
  },
  "keywords": [
    "architecture",
    "code explanation",
    "code review",
    "copilot",
    "explain",
    "learning",
    "owasp",
    "security",
    "walkthrough"
  ],
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Education",
    "AI",
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "In a folder you haven't trusted, coee still explains code and runs its pattern checks, but doesn't run git (Changes, reviews) or npm audit / pip-audit, because a repository's own config can make them run programs."
    },
    "virtualWorkspaces": true
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && node --test \"out/test/*.test.js\"",
    "package": "npx @vscode/vsce package --no-dependencies --no-rewrite-relative-links",
    "test:integration": "npm run compile && vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.0.0",
    "@types/vscode": "~1.95.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "typescript": "^5.6.0"
  },
  "contributes": {
    "commands": [
      {
        "command": "coee.explain",
        "title": "Explain these lines",
        "category": "coee",
        "icon": "$(book)"
      },
      {
        "command": "coee.explainFile",
        "title": "Explain this file",
        "category": "coee",
        "icon": "$(book)"
      },
      {
        "command": "coee.explainResource",
        "title": "Explain this folder",
        "category": "coee",
        "icon": "$(compass)"
      },
      {
        "command": "coee.tour",
        "title": "Explain this project",
        "category": "coee",
        "icon": "$(compass)"
      },
      {
        "command": "coee.plan",
        "title": "Plan a change…",
        "category": "coee",
        "icon": "$(lightbulb)"
      },
      {
        "command": "coee.ask",
        "title": "Ask about this code…",
        "category": "coee",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "coee.security",
        "title": "Security scan…",
        "category": "coee",
        "icon": "$(shield)"
      },
      {
        "command": "coee.prev",
        "title": "Previous step",
        "category": "coee",
        "icon": "$(arrow-up)"
      },
      {
        "command": "coee.next",
        "title": "Next step",
        "category": "coee",
        "icon": "$(arrow-down)"
      },
      {
        "command": "coee.more",
        "title": "More detail on this step",
        "category": "coee",
        "icon": "$(unfold)"
      },
      {
        "command": "coee.close",
        "title": "Close walkthrough",
        "category": "coee",
        "icon": "$(close)"
      },
      {
        "command": "coee.cancel",
        "title": "Stop explaining",
        "category": "coee"
      },
      {
        "command": "coee.explainLines",
        "title": "Explain these lines",
        "category": "coee"
      },
      {
        "command": "coee.recent",
        "title": "Reopen a recent walkthrough",
        "category": "coee",
        "icon": "$(history)"
      },
      {
        "command": "coee.clearCache",
        "title": "Clear cache",
        "category": "coee",
        "icon": "$(trash)"
      },
      {
        "command": "coee.changes",
        "title": "Changes: live review",
        "category": "coee",
        "icon": "$(checklist)"
      },
      {
        "command": "coee.exportSarif",
        "title": "Export security findings as SARIF…",
        "category": "coee",
        "icon": "$(export)"
      },
      {
        "command": "coee.changesApply",
        "title": "Apply suggestion",
        "category": "coee",
        "icon": "$(check)"
      },
      {
        "command": "coee.changesDismiss",
        "title": "Dismiss",
        "category": "coee",
        "icon": "$(close)"
      },
      {
        "command": "coee.changesAsk",
        "title": "Ask coee",
        "category": "coee"
      },
      {
        "command": "coee.reviewCommit",
        "title": "Explain a commit…",
        "category": "coee",
        "icon": "$(git-commit)"
      },
      {
        "command": "coee.architecture",
        "title": "Architecture overview",
        "category": "coee",
        "icon": "$(symbol-structure)"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "submenu": "coee.editor",
          "group": "1_coee@1"
        }
      ],
      "commandPalette": [
        {
          "command": "coee.changesApply",
          "when": "false"
        },
        {
          "command": "coee.changesDismiss",
          "when": "false"
        },
        {
          "command": "coee.changesAsk",
          "when": "false"
        },
        {
          "command": "coee.explain",
          "when": "editorIsOpen"
        },
        {
          "command": "coee.ask",
          "when": "editorIsOpen"
        },
        {
          "command": "coee.prev",
          "when": "coee.active"
        },
        {
          "command": "coee.next",
          "when": "coee.active"
        },
        {
          "command": "coee.more",
          "when": "coee.active"
        },
        {
          "command": "coee.close",
          "when": "coee.active"
        },
        {
          "command": "coee.explainResource",
          "when": "false"
        },
        {
          "command": "coee.tour",
          "when": "workspaceFolderCount > 0"
        },
        {
          "command": "coee.explainLines",
          "when": "false"
        },
        {
          "command": "coee.explainFile",
          "when": "editorIsOpen"
        }
      ],
      "explorer/context": [
        {
          "submenu": "coee.explorer",
          "group": "1_coee@1"
        }
      ],
      "editor/title": [
        {
          "command": "coee.explainFile",
          "when": "resourceScheme == file || resourceScheme == untitled",
          "group": "navigation@90"
        }
      ],
      "coee.editor": [
        {
          "command": "coee.architecture",
          "group": "1_hub@1"
        },
        {
          "command": "coee.explain",
          "when": "editorHasSelection",
          "group": "2_code@1"
        },
        {
          "command": "coee.explainFile",
          "group": "2_code@2"
        },
        {
          "command": "coee.ask",
          "group": "2_code@3"
        }
      ],
      "coee.explorer": [
        {
          "command": "coee.architecture",
          "group": "1_hub@1"
        },
        {
          "command": "coee.explainResource",
          "when": "explorerResourceIsFolder",
          "group": "2_code@1"
        },
        {
          "command": "coee.explainFile",
          "when": "!explorerResourceIsFolder",
          "group": "2_code@1"
        }
      ],
      "scm/title": [
        {
          "command": "coee.changes",
          "when": "scmProvider == git",
          "group": "navigation@90"
        },
        {
          "command": "coee.reviewCommit",
          "when": "scmProvider == git",
          "group": "1_coee@1"
        }
      ],
      "comments/comment/title": [
        {
          "command": "coee.changesApply",
          "when": "commentController == coee && comment == coee-fix",
          "group": "inline@1"
        },
        {
          "command": "coee.changesDismiss",
          "when": "commentController == coee && comment =~ /^coee/",
          "group": "inline@2"
        }
      ],
      "comments/commentThread/context": [
        {
          "command": "coee.changesAsk",
          "when": "commentController == coee",
          "group": "inline@1"
        }
      ],
      "scm/historyItem/context": [
        {
          "command": "coee.reviewCommit",
          "group": "1_coee@1"
        }
      ]
    },
    "keybindings": [
      {
        "command": "coee.explain",
        "key": "ctrl+alt+e",
        "mac": "cmd+alt+e",
        "when": "editorTextFocus"
      },
      {
        "command": "coee.next",
        "key": "alt+]",
        "when": "coee.active"
      },
      {
        "command": "coee.prev",
        "key": "alt+[",
        "when": "coee.active"
      }
    ],
    "configuration": {
      "title": "coee",
      "properties": {
        "coee.modelFamily": {
          "type": "string",
          "default": "",
          "order": 2,
          "markdownDescription": "Preferred chat model family (e.g. `gpt-4o`, `claude-sonnet-4`). Empty uses the first available model."
        },
        "coee.codeLens": {
          "type": "boolean",
          "default": true,
          "order": 0,
          "description": "Show an Explain link above each function, method and class."
        },
        "coee.changes.autoReview": {
          "type": "string",
          "enum": [
            "onStage",
            "onSave",
            "off"
          ],
          "enumDescriptions": [
            "Review a file with the model when you stage it (fast pattern checks run on every save).",
            "Review each changed file with the model when you save it.",
            "Only fast pattern checks run on their own; the model reviews when you click Review."
          ],
          "default": "onStage",
          "order": 4,
          "description": "When the Changes view asks the chat model to review your uncommitted changes."
        },
        "coee.cache": {
          "type": "boolean",
          "default": true,
          "order": 3,
          "markdownDescription": "Keep finished walkthroughs, so reopening one is instant. Any edit to the code gets a fresh explanation anyway.\n\n[Clear coee's cache](command:coee.clearCache) removes saved walkthroughs, the recent list and saved system maps."
        }
      }
    },
    "colors": [
      {
        "id": "coee.highlightBackground",
        "description": "Background of the lines coee is explaining.",
        "defaults": {
          "dark": "#4F9CF91F",
          "light": "#2F6FD226",
          "highContrast": "#4F9CF933",
          "highContrastLight": "#2F6FD233"
        }
      },
      {
        "id": "coee.highlightBorder",
        "description": "Marker beside the lines coee is explaining, and its accents.",
        "defaults": {
          "dark": "#4F9CF9",
          "light": "#2F6FD2",
          "highContrast": "#4F9CF9",
          "highContrastLight": "#1F4FA0"
        }
      }
    ],
    "submenus": [
      {
        "id": "coee.editor",
        "label": "coee"
      },
      {
        "id": "coee.explorer",
        "label": "coee"
      }
    ]
  }
}
